# Copy to .env and fill in. Never commit .env.

# Qdrant: local Docker by default; replace with your Qdrant Cloud URL + key if used
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Databricks (for logging local runs to Databricks-hosted MLflow later)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=

# LLM (stage 7): Gemini free tier, or leave blank and use Ollama locally
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
